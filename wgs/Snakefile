configfile: "config/config.yaml"

import csv
import math
from pathlib import Path


def read_tsv(path):
    rows = []
    with open(path, encoding="utf-8-sig") as handle:
        for line in handle:
            if line.startswith("#") or not line.strip():
                continue
            rows.append(line.rstrip("\n").split("\t"))
    if not rows:
        return [], []
    return rows[0], rows[1:]


def read_samples(path):
    header, rows = read_tsv(path)
    if not header:
        return {}
    idx = {name: i for i, name in enumerate(header)}
    required = {"sample_id", "r1", "r2"}
    missing = required - set(idx)
    if missing:
        raise ValueError(f"Missing samples.tsv columns: {sorted(missing)}")
    return {
        row[idx["sample_id"]]: {
            "r1": row[idx["r1"]],
            "r2": row[idx["r2"]],
        }
        for row in rows
        if row and row[idx["sample_id"]]
    }


def read_lines(path):
    with open(path, encoding="utf-8") as handle:
        return [x.strip() for x in handle if x.strip() and not x.startswith("#")]


SAMPLE_INFO = read_samples(config["samples"])
SAMPLES = sorted(SAMPLE_INFO)
CHROMOSOMES = read_lines(config["chromosomes"])
REF = config["reference"]["fasta"]
GFF = config["reference"].get("gff3", "")
FUNCTIONAL_ANNOTATION = config["reference"].get("functional_annotation", "")
PLOIDY = int(config["analysis"]["ploidy"])
MIN_AN = math.ceil(len(SAMPLES) * PLOIDY * float(config["analysis"]["stage4_call_rate"])) if SAMPLES else 0
K_VALUES = list(range(
    int(config["population_structure"]["admixture_k_min"]),
    int(config["population_structure"]["admixture_k_max"]) + 1,
))


def fastq_for(wildcards):
    return SAMPLE_INFO[wildcards.sample][wildcards.read]


